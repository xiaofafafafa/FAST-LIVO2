<launch>
  <arg name="rviz" default="true" />
  <arg name="use_sim_time" default="false" />
  <param name="/use_sim_time" value="$(arg use_sim_time)" type="bool" />

  <rosparam command="load" file="$(find fast_livo)/config/avia.yaml" />
  <rosparam command="load" file="$(find fast_livo)/config/adaptive_window.yaml" />
  <param name="common/img_en" value="0" type="int" />
  <param name="preprocess/lidar_type" value="8" type="int" />
  <param name="preprocess/scan_line" value="4" type="int" />
  <!-- Set the measured LiDAR to IMU extrinsics before evaluating accuracy. -->
  <rosparam param="extrin_calib/extrinsic_T">[0.0, 0.0, 0.0]</rosparam>

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_pinhole.yaml" />
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
